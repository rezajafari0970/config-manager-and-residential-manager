[Unit]
Description=Config manager verified inactive test-artifact archival
ConditionPathExists=/etc/config-repair/artifact-policy.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/config-repair/current/scripts/artifact-archive.py --registry /etc/config-repair/artifact-policy.json --apply
User=root
UMask=0077
Nice=15
CPUWeight=10
CPUQuota=25%
IOWeight=10
MemoryMax=192M
TasksMax=16
RuntimeMaxSec=2400
NoNewPrivileges=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateNetwork=true
