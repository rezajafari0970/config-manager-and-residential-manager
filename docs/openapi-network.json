{
  "openapi": "3.0.3",
  "info": {
    "title": "Config Manager network grouping API",
    "version": "2.0.0"
  },
  "paths": {
    "/api/datacenter": {
      "get": {
        "summary": "Group counts, scoped export URLs, pending work and feed validity",
        "responses": {
          "200": {
            "description": "datacenters (11), cdns (7), total received inventory, pending, feeds, now. Groups include inventory_count, coverage (exclusive states), raw_count=ready_count=xray_ready+native_ready, tested/core-passed counters and scoped raw/single/all/native/received URLs."
          },
          "503": {
            "description": "Store temporarily unavailable"
          }
        }
      }
    },
    "/subscription/network/{axis}/{group}/{token}/{file}": {
      "parameters": [
        {
          "name": "axis",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "datacenter",
              "cdn"
            ]
          }
        },
        {
          "name": "group",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "token",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "file",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "raw.txt",
              "received.txt",
              "next.json",
              "configs.json",
              "native.jsonl",
              "native-next.json"
            ]
          }
        }
      ],
      "get": {
        "summary": "Verified raw/templates by canonical identity; received.txt is explicitly unverified diagnostic inventory",
        "responses": {
          "200": {
            "description": "Exact group member(s); X-Config-Count, X-Content-SHA256, X-Network-Axis, X-Network-Group; next.json also X-Export-Cycle"
          },
          "204": {
            "description": "No eligible current members; no fallback"
          },
          "404": {
            "description": "Invalid scope, format or token"
          },
          "503": {
            "description": "Temporary failure; no cross-group output"
          }
        }
      },
      "head": {
        "summary": "Validate token and scope without consuming a rotation turn",
        "responses": {
          "200": {
            "description": "Valid link (does not imply group is populated)"
          },
          "404": {
            "description": "Invalid scoped token"
          }
        }
      }
    }
  }
}
