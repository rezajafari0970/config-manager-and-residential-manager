{
  "openapi": "3.1.0",
  "info": {
    "title": "Config preparation exports",
    "version": "44"
  },
  "paths": {
    "/api/prepared/export": {
      "get": {
        "summary": "Export one verified template per current canonical input",
        "description": "Every exported template has fresh exact-byte core and connection proof. Xray groups are JSON arrays, native groups are JSONL. Single exports are JSON objects. Health filtering is always enabled, including when healthy is omitted or 0.",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional source ID"
          },
          {
            "name": "engine",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "xray",
                "sing-box"
              ],
              "default": "xray"
            },
            "description": "Output core format"
          },
          {
            "name": "single",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Rotate one JSON profile"
          },
          {
            "name": "healthy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Deprecated compatibility parameter; cannot disable mandatory exact-byte health proof",
            "deprecated": true
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional canonical configuration ID"
          },
          {
            "name": "network_axis",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional datacenter, cdn or ip-family axis"
          },
          {
            "name": "network_group",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Group ID, required with network_axis"
          }
        ],
        "responses": {
          "200": {
            "description": "Current owned templates; inspect X-Verification-Scope and X-Config-Engine"
          },
          "204": {
            "description": "No eligible single profile"
          },
          "404": {
            "description": "Unknown source"
          },
          "409": {
            "description": "Membership changed during export; retry"
          },
          "422": {
            "description": "Invalid engine"
          },
          "503": {
            "description": "A verified blob is unavailable or invalid; no partial export"
          }
        }
      },
      "head": {
        "summary": "Validate scope without consuming rotation",
        "responses": {
          "200": {
            "description": "Valid scope; does not imply a populated group"
          }
        }
      }
    }
  }
}
